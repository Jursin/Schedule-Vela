<template>
  <div class="page">
    <text class="pill-time">{{ currentTime }}</text>
    <text class="title title-round">设置</text>
    <div class="title-row title-rect">
      <div class="title-left" onclick="goBack">
        <div class="title-back-btn">
          <image class="title-back-icon" src="/common/left.png"></image>
        </div>
        <text class="title-text">设置</text>
      </div>
      <text class="title-text">{{ currentTime }}</text>
    </div>

    <scroll class="settings-list" scroll-y="true" bounces="true">
      <div class="settings-item{{ semesterStartDate ? ' settings-item-value' : '' }}" onclick="openDatePicker">
        <text class="item-text">开学日期</text>
        <text class="item-subtext" if="{{ semesterStartDate }}">{{ semesterStartDate }}</text>
      </div>
      <div class="settings-item{{ semesterTotalWeeks ? ' settings-item-value' : '' }}" onclick="openWeekPicker">
        <text class="item-text">学期周数</text>
        <text class="item-subtext" if="{{ semesterTotalWeeks }}">
          {{ semesterTotalWeeks }} 周
        </text>
      </div>
      <div class="settings-item" onclick="openPersonalize">
        <text class="item-text">个性化</text>
      </div>
      <div class="settings-item" onclick="openAbout">
        <text class="item-text">关于</text>
      </div>
      <div class="settings-item" onclick="clearSchedule">
        <text class="item-text item-text-warn">
          {{ clearConfirming ? "确认清除" : "清除配置" }}
        </text>
      </div>
    </scroll>
  </div>
</template>

<script>
import router from "@system.router"
import storage from "@system.storage"
import prompt from "@system.prompt"
import vibrator from "@system.vibrator"

const STORAGE_KEY = "schedule_data"
const utils = require("../../common/utils.js")

function parseStoragePayload(raw) {
  try {
    return JSON.parse(raw)
  } catch (err) {
    return null
  }
}

function validateSchedule(data) {
  if (!data || !data.courses || !data.timeSlots) {
    return false
  }
  if (!Array.isArray(data.courses) || !Array.isArray(data.timeSlots)) {
    return false
  }
  return true
}

export default {
  private: {
    scheduleData: utils.createEmptySchedule(),
    semesterStartDate: "",
    semesterTotalWeeks: "",
    clearConfirming: false,
    currentTime: "",
    timerId: 0
  },

  onInit() {
    utils.startClock(this)
    this.loadData()
  },

  onDestroy() {
    utils.stopClock(this)
  },

  onHide() {
    utils.stopClock(this)
  },

  goBack() {
    router.back()
  },

  onShow() {
    utils.startClock(this)
    this.loadData()
  },

  loadData() {
    const resetState = () => {
      this.scheduleData = utils.createEmptySchedule()
      this.semesterStartDate = ""
      this.semesterTotalWeeks = ""
      this.clearConfirming = false
    }

    storage.get({
      key: STORAGE_KEY,
      success: (raw) => {
        const data = parseStoragePayload(raw)
        if (validateSchedule(data)) {
          this.scheduleData = data
          this.semesterStartDate = (data.config && data.config.semesterStartDate) || ""
          this.semesterTotalWeeks = (data.config && data.config.semesterTotalWeeks) || ""
          this.clearConfirming = false
          return
        }
        resetState()
      },
      fail: () => {
        resetState()
      }
    })
  },

  openPersonalize() {
    router.push({
      uri: "/pages/personalize"
    })
  },

  openDatePicker() {
    router.push({
      uri: "/pages/date-picker",
      params: {
        semesterStartDate: this.semesterStartDate
      }
    })
  },

  openWeekPicker() {
    router.push({
      uri: "/pages/week-picker",
      params: {
        semesterTotalWeeks: this.semesterTotalWeeks
      }
    })
  },

  openAbout() {
    router.push({
      uri: "/pages/about"
    })
  },

  clearSchedule() {
    if (!this.clearConfirming) {
      this.clearConfirming = true
      return
    }
    storage.set({
      key: STORAGE_KEY,
      value: JSON.stringify(utils.createEmptySchedule()),
      success: () => {
        this.semesterStartDate = ""
        this.semesterTotalWeeks = ""
        this.clearConfirming = false
        // 清除成功后震动一次
        try {
          vibrator.vibrate({mode: "short"})
        } catch (e) {
          // 震动失败可忽略
        }
        prompt.showToast({
          message: "已清除配置",
          duration: 1200
        })
      },
      fail: () => {
        this.clearConfirming = false
        prompt.showToast({
          message: "清除失败",
          duration: 2000
        })
      }
    })
  }
}
</script>

<style>
.page {
  flex-direction: column;
  width: 100%;
  height: 100%;
  padding: 32px 0 6px;
  background-color: #000000;
  align-items: center;
}

.pill-time {
  position: absolute;
  top: 4px;
  font-size: 24px;
  font-weight: bold;
  color: rgba(255, 255, 255, 0.6);
  display: flex;
}

.title {
  color: #ffffff;
  font-size: 26px;
  font-weight: 800;
}

.title-rect {
  display: none;
}

.title-row {
  width: 100%;
  padding: 0 6px;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.title-left {
  flex-direction: row;
  align-items: center;
}

.title-back-btn {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background-color: transparent;
  align-items: center;
  justify-content: center;
  margin-right: 8px;
}

.title-back-icon {
  width: 28px;
  height: 28px;
}

.title-text {
  color: #ffffff;
  font-size: 30px;
  font-weight: 800;
}

.settings-list {
  flex: 1;
  width: 95%;
  flex-direction: column;
  padding-top: 10px;
  padding-bottom: 60px;
}

.settings-item {
  width: 100%;
  height: 70px;
  margin-top: 8px;
  padding: 0 16px;
  border-radius: 20px;
  background-color: rgba(38, 38, 38, 1);
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
}

.settings-item-value {
  height: 101px;
}

.item-text {
  color: #ffffff;
  font-size: 24px;
  font-weight: 800;
}

.item-subtext {
  margin-top: 4px;
  color: #aaaaaa;
  font-size: 20px;
  font-weight: 700;
}

.item-text-warn {
  color: #bd0000;
}

@media (shape: rect) {
  page {
    padding: 18px 0 6px;
  }

  .pill-time {
    display: none;
  }

  .title-round {
    display: none;
  }

  .title-rect {
    display: flex;
    margin-bottom: 8px;
  }

  .settings-list {
    padding-top: 0;
    padding-bottom: 30px;
  }

  .settings-item {
    height: 80px;
  }

  .settings-item-value {
    height: 95px;
  }

  .item-text {
    font-size: 26px;
  }

  .item-subtext {
    font-size: 24px;
  }
}
</style>
