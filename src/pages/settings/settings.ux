<template>
  <div class="page">
    <text class="title title-round">设置</text>
    <div class="title-row title-rect">
      <div class="title-left" onclick="goBack">
        <text class="title-back">&lt;</text>
        <text class="title-text">设置</text>
      </div>
      <text class="title-text">{{ currentTime }}</text>
    </div>

    <list class="settings-list">
      <list-item type="default" class="settings-item settings-item-date" onclick="openDatePicker">
        <div class="item-main-row">
          <div class="item-left-col">
            <text class="item-text">开学日期</text>
            <text class="item-subtext" if="{{ semesterStartDate }}">{{ semesterStartDate }}</text>
          </div>
          <text class="item-arrow">&gt;</text>
        </div>
      </list-item>
      <list-item type="default" class="settings-item settings-item-date" onclick="openWeekPicker">
        <div class="item-main-row">
          <div class="item-left-col">
            <text class="item-text">学期周数</text>
            <text class="item-subtext" if="{{ semesterTotalWeeks }}">
              {{ semesterTotalWeeks }} 周
            </text>
          </div>
          <text class="item-arrow">&gt;</text>
        </div>
      </list-item>
      <list-item type="default" class="settings-item settings-item-nav" onclick="openPersonalize">
        <div class="item-main-row">
          <div class="item-left-col">
            <text class="item-text">个性化</text>
          </div>
          <text class="item-arrow">&gt;</text>
        </div>
      </list-item>
      <list-item type="default" class="settings-item settings-item-warn" onclick="clearSchedule">
        <text class="item-text item-text-warn">
          {{ clearConfirming ? "确认清除" : "清除配置" }}
        </text>
      </list-item>
      <list-item type="default" class="settings-item" onclick="openAbout">
        <text class="item-text">关于</text>
      </list-item>
    </list>
  </div>
</template>

<script>
import router from "@system.router"
import storage from "@system.storage"
import prompt from "@system.prompt"
import vibrator from "@system.vibrator"

const STORAGE_KEY = "schedule_data"
const utils = require("../../common/utils.js")

function parseStoragePayload(raw) {
  try {
    return JSON.parse(raw)
  } catch (err) {
    return null
  }
}

function validateSchedule(data) {
  if (!data || !data.courses || !data.timeSlots) {
    return false
  }
  if (!Array.isArray(data.courses) || !Array.isArray(data.timeSlots)) {
    return false
  }
  return true
}

export default {
  private: {
    scheduleData: utils.createEmptySchedule(),
    semesterStartDate: "",
    semesterTotalWeeks: "",
    clearConfirming: false,
    currentTime: "",
    timerId: 0
  },

  onInit() {
    utils.startClock(this)
    this.loadData()
  },

  onDestroy() {
    utils.stopClock(this)
  },

  goBack() {
    router.back()
  },

  onShow() {
    this.loadData()
  },

  loadData() {
    const resetState = () => {
      this.scheduleData = utils.createEmptySchedule()
      this.semesterStartDate = ""
      this.semesterTotalWeeks = ""
      this.clearConfirming = false
    }

    storage.get({
      key: STORAGE_KEY,
      success: (raw) => {
        const data = parseStoragePayload(raw)
        if (validateSchedule(data)) {
          this.scheduleData = data
          this.semesterStartDate = (data.config && data.config.semesterStartDate) || ""
          this.semesterTotalWeeks = (data.config && data.config.semesterTotalWeeks) || ""
          this.clearConfirming = false
          return
        }
        resetState()
      },
      fail: () => {
        resetState()
      }
    })
  },

  openPersonalize() {
    router.push({
      uri: "/pages/personalize"
    })
  },

  openDatePicker() {
    router.push({
      uri: "/pages/date-picker",
      params: {
        semesterStartDate: this.semesterStartDate
      }
    })
  },

  openWeekPicker() {
    router.push({
      uri: "/pages/week-picker",
      params: {
        semesterTotalWeeks: this.semesterTotalWeeks
      }
    })
  },

  openAbout() {
    router.push({
      uri: "/pages/about"
    })
  },

  clearSchedule() {
    if (!this.clearConfirming) {
      this.clearConfirming = true
      return
    }
    storage.set({
      key: STORAGE_KEY,
      value: JSON.stringify(utils.createEmptySchedule()),
      success: () => {
        this.semesterStartDate = ""
        this.semesterTotalWeeks = ""
        this.clearConfirming = false
        // 清除成功后震动一次
        try {
          vibrator.vibrate({mode: "short"})
        } catch (e) {
          // 震动失败可忽略
        }
        prompt.showToast({
          message: "已清除配置",
          duration: 1200
        })
      },
      fail: () => {
        this.clearConfirming = false
        prompt.showToast({
          message: "清除失败",
          duration: 2000
        })
      }
    })
  }
}
</script>

<style>
.page {
  flex-direction: column;
  width: 100%;
  height: 100%;
  padding: 18px 0 6px;
  background-color: #000000;
  align-items: center;
}

.title {
  color: #ffffff;
  font-size: 26px;
  font-weight: 800;
}

.title-rect {
  display: none;
}

.title-row {
  width: 100%;
  padding: 0 18px;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.title-left {
  flex-direction: row;
  align-items: center;
}

.title-back {
  margin-right: 12px;
}

.title-back,
.title-text {
  color: #ffffff;
  font-size: 30px;
  font-weight: 800;
}

.settings-list {
  flex: 1;
  width: 90%;
  flex-direction: column;
}

.settings-item {
  width: 100%;
  height: 64px;
  margin-top: 8px;
  border-radius: 20px;
  border-width: 2px;
  border-color: #3b3b3b;
  background-color: #111111;
  align-items: center;
  justify-content: center;
}

.settings-item-date {
  height: 95px;
  padding: 0 16px;
}

.settings-item-nav {
  height: 64px;
  padding: 0 16px;
}

.item-main-row {
  width: 100%;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.item-left-col {
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
}

.item-subtext {
  margin-top: 4px;
  color: #aaaaaa;
  font-size: 20px;
  font-weight: 700;
}

.item-arrow {
  color: #666666;
  font-size: 28px;
  font-weight: 700;
}

.item-text {
  color: #ffffff;
  font-size: 22px;
  font-weight: 800;
}

.settings-item-warn {
  border-color: #4a2b2b;
}

.item-text-warn {
  color: #bd0000;
}

@media (shape: rect) {
  .title-round {
    display: none;
  }

  .title-rect {
    display: flex;
    margin-bottom: 8px;
  }

  .item-text {
    font-size: 26px;
  }

  .item-subtext {
    font-size: 24px;
  }

  .item-arrow {
    font-size: 32px;
  }
}

@media (shape: pill-shaped) {
  .settings-list {
    padding-bottom: 60px;
  }
}
</style>
