  color: #ffffff;
  font-size: 26px;
  font-weight: 800;
  margin-bottom: 30px;
}

.title-rect {
  display: none;
}

.title-row {
  width: 100%;
  padding: 0 6px;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.title-left {
  flex-direction: row;
  align-items: center;
}

.title-back-btn {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background-color: transparent;
  align-items: center;
  justify-content: center;
  margin-right: 8px;
}

.title-back-icon {
  width: 28px;
  height: 28px;
}

.title-text {
  color: #ffffff;
  font-size: 30px;
  font-weight: 800;
}

.app-icon {
  width: 100px;
  height: 100px;
  margin-bottom: 30px;
}

.app-name {
  color: #ffffff;
  font-size: 28px;
  font-weight: 800;
  margin-bottom: 15px;
  text-align: center;
}

.app-meta {
  color: #cccccc;
  font-size: 22px;
  font-weight: 700;
  margin-bottom: 8px;
  text-align: center;
}

@media (shape: rect) {
  .title-round {
    display: none;
  }

  .title-rect {
    display: flex;
    margin-bottom: 16px;
  }

  .app-icon {
    width: 120px;
