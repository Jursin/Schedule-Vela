<template>
  <div class="page">
    <scroll scroll-y="true" class="page-scroll">
      <div class="page-content">
        <div class="time-section">
          <text class="current-time">{{ currentTime }}</text>
        </div>
        <div class="course-section">
          <text class="course-name">{{ course.name }}</text>
          <text class="course-meta">{{ course.timeText }}</text>
          <text class="course-meta">{{ course.position }}</text>
          <text class="course-meta" if="{{ course.teacher }}">{{ course.teacher }}</text>
          <text
            class="remaining-time"
            style="color: {{ themeColor }}"
            if="{{ showUpcomingReminder }}"
          >
            还剩{{ upcomingMinutes }}分钟上课
          </text>
          <progress
            class="course-progress"
            style="color: {{ themeColor }}"
            if="{{ showUpcomingReminder }}"
            percent="{{ upcomingProgressPercent }}"
            type="horizontal"
          ></progress>
          <text class="remaining-time" style="color: {{ themeColor }}" if="{{ course.isOngoing }}">
            还剩{{ remainingMinutes }}分钟下课
          </text>
          <progress
            class="course-progress"
            style="color: {{ themeColor }}"
            if="{{ course.isOngoing }}"
            percent="{{ course.progressPercent }}"
            type="horizontal"
          ></progress>
        </div>
        <div class="next-course-section" if="{{ nextCourse.name }}">
          <text class="next-course-label">下一节</text>
          <text class="next-course-name">{{ nextCourse.name }}</text>
          <text class="next-course-meta" if="{{ nextCourse.position }}">
            {{ nextCourse.position }}
          </text>
        </div>
      </div>
    </scroll>
  </div>
</template>

<script>
const preferences = require("../../common/preferences.js")
const utils = require("../../common/utils.js")

export default {
  protected: {
    course: {
      name: "",
      timeText: "",
      position: "",
      teacher: "",
      isOngoing: false,
      progressPercent: 0
    },
    todayCourses: []
  },

  private: {
    currentTime: "",
    themeColor: preferences.DEFAULT_COLOR,
    remainingMinutes: 0,
    upcomingMinutes: 0,
    showUpcomingReminder: false,
    upcomingProgressPercent: 0,
    nextCourse: {
      name: "",
      position: ""
    },
    sortedTodayCourses: [],
    reminderWindow: null,
    timer: null
  },

  onInit() {
    // 解析参数
    try {
      const courseData = typeof this.course === "string" ? JSON.parse(this.course) : this.course
      this.course = courseData
      if (this.todayCourses) {
        this.todayCourses =
          typeof this.todayCourses === "string" ? JSON.parse(this.todayCourses) : this.todayCourses
      }
    } catch (e) {
      console.error("Failed to parse params:", e)
    }
    this.initTodayCourseIndex()
    this.calculateRemainingTime()
    this.calculateUpcomingReminder()
    this.calculateNextCourse()
    this.updateCurrentTime()
    this.loadPreference()
    this.timer = setInterval(() => {
      this.updateCurrentTime()
      if (this.course.isOngoing) {
        this.calculateRemainingTime()
        this.calculateNextCourse()
      }
      if (this.inReminderWindow() || this.showUpcomingReminder) {
        this.calculateUpcomingReminder()
      }
    }, 1000)
  },

  // 预处理当天课程排序与提醒生效区间
  initTodayCourseIndex() {
    const courses = Array.isArray(this.todayCourses) ? this.todayCourses : []
    this.sortedTodayCourses = courses.slice().sort((a, b) => {
      const t1 = a.timeText && a.timeText.split("-")[0]
      const t2 = b.timeText && b.timeText.split("-")[0]
      if (!t1 || !t2) {
        return 0
      }
      const start1 = utils.timeToMinutes(t1)
      const start2 = utils.timeToMinutes(t2)
      return (start1 === null ? 0 : start1) - (start2 === null ? 0 : start2)
    })
    let lastEnd = 0
    for (let i = 0; i < this.sortedTodayCourses.length; i += 1) {
      const timeText = this.sortedTodayCourses[i].timeText
      if (timeText && timeText.indexOf("-") > 0) {
        const end = utils.timeToMinutes(timeText.split("-")[1])
        if (end !== null && end > lastEnd) {
          lastEnd = end
        }
      }
    }
    this.reminderWindow =
      this.sortedTodayCourses.length > 0 ? {from: 7 * 60, to: lastEnd} : null
  },

  inReminderWindow() {
    if (!this.reminderWindow) {
      return false
    }
    const now = new Date()
    const currentMinutes = now.getHours() * 60 + now.getMinutes()
    return (
      currentMinutes >= this.reminderWindow.from && currentMinutes <= this.reminderWindow.to
    )
  },

  loadPreference() {
    preferences.getPreferences((pref) => {
      this.themeColor = pref.themeColor
    })
  },

  courseMatchKey(course) {
    if (!course || typeof course !== "object") {
      return ""
    }
    // 使用名称+时间作为匹配键
    return (course.name || "") + "|" + (course.timeText || "")
  },

  // 上课时底部显示下一节课课程名和教室
  calculateNextCourse() {
    let nextName = ""
    let nextPosition = ""
    // 仅在当前课程进行中时显示
    if (
      this.course &&
      this.course.isOngoing &&
      Array.isArray(this.todayCourses) &&
      this.todayCourses.length > 0
    ) {
      const timeText = this.course.timeText
      if (timeText && timeText.indexOf("-") >= 0) {
        const currentEndMinutes = utils.timeToMinutes(timeText.split("-")[1])
        if (currentEndMinutes !== null) {
          // todayCourses 已按开始时间排序，取首个晚于当前课结束的课程
          const currentKey = this.courseMatchKey(this.course)
          for (let i = 0; i < this.todayCourses.length; i++) {
            const item = this.todayCourses[i]
            if (this.courseMatchKey(item) === currentKey) {
              continue
            }
            const startMinutes = utils.timeToMinutes(item.timeText && item.timeText.split("-")[0])
            if (startMinutes !== null && startMinutes > currentEndMinutes) {
              nextName = item.name || ""
              nextPosition = item.position || ""
              break
            }
          }
        }
      }
    }
    // 仅在值变化时更新，避免每秒触发渲染
    if (this.nextCourse.name !== nextName || this.nextCourse.position !== nextPosition) {
      this.nextCourse.name = nextName
      this.nextCourse.position = nextPosition
    }
  },

  onDestroy() {
    if (this.timer) {
      clearInterval(this.timer)
    }
  },

  updateCurrentTime() {
    const now = new Date()
    const hours = String(now.getHours()).padStart(2, "0")
    const minutes = String(now.getMinutes()).padStart(2, "0")
    const seconds = String(now.getSeconds()).padStart(2, "0")
    this.currentTime = `${hours}:${minutes}:${seconds}`
  },

  calculateRemainingTime() {
    if (!this.course.isOngoing) return

    const timeText = this.course.timeText
    if (!timeText) return

    const timeParts = timeText.split("-")
    if (timeParts.length !== 2) return

    const startTime = timeParts[0]
    const endTime = timeParts[1]
    const [startHour, startMinute] = startTime.split(":").map(Number)
    const [endHour, endMinute] = endTime.split(":").map(Number)

    const now = new Date()
    const totalStartSeconds = (startHour * 60 + startMinute) * 60
    const totalEndSeconds = (endHour * 60 + endMinute) * 60
    const totalCurrentSeconds = now.getHours() * 3600 + now.getMinutes() * 60 + now.getSeconds()

    const remainingSeconds = totalEndSeconds - totalCurrentSeconds
    if (remainingSeconds <= 0) {
      this.remainingMinutes = 0
      this.course.isOngoing = false
      this.course.progressPercent = 100
      return
    }

    this.remainingMinutes = Math.ceil(remainingSeconds / 60)
    const durationSeconds = totalEndSeconds - totalStartSeconds
    if (durationSeconds > 0) {
      let percent = Math.floor(((totalCurrentSeconds - totalStartSeconds) * 100) / durationSeconds)
      if (percent < 0) percent = 0
      if (percent > 100) percent = 100
      this.course.progressPercent = percent
    }
  },

  // 上课提醒和进度条
  calculateUpcomingReminder() {
    // 只针对当天课程
    if (!this.sortedTodayCourses || this.sortedTodayCourses.length === 0) {
      this.showUpcomingReminder = false
      return
    }
    // 使用预排序课程
    const sorted = this.sortedTodayCourses
    const now = new Date()
    const currentMinutes = now.getHours() * 60 + now.getMinutes()
    // 构造所有区间
    const intervals = []
    const currentCourseKey = this.courseMatchKey(this.course)
    // 07:00 到第一节课
    if (sorted.length > 0) {
      const firstStart = sorted[0].timeText && sorted[0].timeText.split("-")[0]
      if (firstStart) {
        const [h, m] = firstStart.split(":").map(Number)
        const startMin = h * 60 + m
        intervals.push({
          from: 7 * 60,
          to: startMin,
          courseKey: this.courseMatchKey(sorted[0])
        })
      }
    }
    // 两节课之间
    for (let i = 1; i < sorted.length; i++) {
      const prevEnd = sorted[i - 1].timeText && sorted[i - 1].timeText.split("-")[1]
      const currStart = sorted[i].timeText && sorted[i].timeText.split("-")[0]
      if (prevEnd && currStart) {
        const [ph, pm] = prevEnd.split(":").map(Number)
        const [ch, cm] = currStart.split(":").map(Number)
        const prevEndMin = ph * 60 + pm
        const currStartMin = ch * 60 + cm
        if (currStartMin > prevEndMin) {
          intervals.push({
            from: prevEndMin,
            to: currStartMin,
            courseKey: this.courseMatchKey(sorted[i])
          })
        }
      }
    }
    // 判断当前时间是否在某个区间，且当前详情页课程为该区间即将开始的课程
    let matched = null
    for (let i = 0; i < intervals.length; i++) {
      const itv = intervals[i]
      if (
        currentMinutes >= itv.from &&
        currentMinutes < itv.to &&
        currentCourseKey &&
        currentCourseKey === itv.courseKey
      ) {
        matched = itv
        break
      }
    }
    if (matched) {
      this.upcomingMinutes = matched.to - currentMinutes
      this.showUpcomingReminder = true
      // 进度条百分比 = (currentMinutes - from) / (to - from)
      let percent = Math.floor(
        ((currentMinutes - matched.from) * 100) / (matched.to - matched.from)
      )
      if (percent < 0) percent = 0
      if (percent > 100) percent = 100
      this.upcomingProgressPercent = percent
    } else {
      this.showUpcomingReminder = false
    }
  }
}
</script>

<style>
.page {
  flex-direction: column;
  width: 100%;
  height: 100%;
  background-color: #000000;
  align-items: center;
}

.page-scroll {
  flex: 1;
  width: 100%;
  flex-direction: column;
}

.page-content {
  flex-direction: column;
  width: 100%;
  min-height: 100%;
  align-items: center;
  justify-content: center;
  padding: 60px 10px;
}

.time-section {
  margin-bottom: 16px;
}

.current-time {
  color: #ffffff;
  font-size: 38px;
  font-weight: 700;
}

.course-section {
  flex-direction: column;
  width: 100%;
  align-items: center;
}

.next-course-section {
  flex-direction: column;
  width: 100%;
  align-items: center;
  padding-top: 24px;
}

.next-course-label {
  color: #999999;
  font-size: 20px;
  font-weight: 700;
  margin-bottom: 6px;
  text-align: center;
}

.next-course-name {
  color: #ffffff;
  font-size: 26px;
  font-weight: 700;
  margin-bottom: 2px;
  text-align: center;
}

.next-course-meta {
  color: #cccccc;
  font-size: 22px;
  font-weight: 700;
  text-align: center;
}

.course-name {
  color: #ffffff;
  font-size: 30px;
  font-weight: 700;
  margin-bottom: 16px;
  text-align: center;
}

.course-meta {
  color: #cccccc;
  font-size: 28px;
  font-weight: 700;
  margin-bottom: 4px;
  text-align: center;
}

.remaining-time {
  color: #237bff;
  font-size: 23px;
  font-weight: 700;
  margin: 14px 0;
  text-align: center;
}

.course-progress {
  width: 100%;
  margin-top: 10px;
  stroke-width: 10px;
  color: #237bff;
  layer-color: rgba(255, 255, 255, 0.2);
}

@media (shape: rect) {
  .page-content {
    padding: 45px 10px;
  }

  .current-time {
    font-size: 60px;
  }

  .course-name {
    font-size: 34px;
  }

  .course-meta {
    font-size: 32px;
  }

  .next-course-label {
    font-size: 22px;
  }

  .next-course-name {
    font-size: 28px;
  }

  .next-course-meta {
    font-size: 24px;
  }
}
</style>
