  flex-direction: column;
  width: 100%;
  height: 100%;
  padding: 18px 0 6px;
  background-color: #000000;
  align-items: center;
}

.title {
  color: #ffffff;
  font-size: 26px;
  font-weight: 800;
}

.title-rect {
  display: none;
}

.title-row {
  width: 100%;
  padding: 0 18px;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.title-left {
  flex-direction: row;
  align-items: center;
}

.title-back {
  margin-right: 12px;
}

.title-back,
.title-text {
  color: #ffffff;
  font-size: 30px;
  font-weight: 800;
}

.color-list {
  flex: 1;
  width: 90%;
  flex-direction: column;
}

.color-item {
  width: 100%;
  height: 64px;
  margin-top: 8px;
  border-radius: 20px;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 0 16px;
}

.color-name {
  color: #ffffff;
  font-size: 22px;
  font-weight: 800;
}

.color-tick {
  width: 24px;
  height: 24px;
}

@media (shape: rect) {
  .title-round {
    display: none;
  }

  .title-rect {
    display: flex;
    margin-bottom: 8px;
  }

  .color-name {
    font-size: 26px;
  }
}
</style>
