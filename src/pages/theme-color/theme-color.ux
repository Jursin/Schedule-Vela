  position: absolute;
  top: 4px;
  font-size: 24px;
  font-weight: bold;
  color: rgba(255, 255, 255, 0.6);
  display: flex;
}

.title {
  color: #ffffff;
  font-size: 26px;
  font-weight: 800;
}

.title-rect {
  display: none;
}

.title-row {
  width: 100%;
  padding: 0 6px;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.title-left {
  flex-direction: row;
  align-items: center;
}

.title-back-btn {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background-color: transparent;
  align-items: center;
  justify-content: center;
  margin-right: 8px;
}

.title-back-icon {
  width: 28px;
  height: 28px;
}

.title-text {
  color: #ffffff;
  font-size: 30px;
  font-weight: 800;
}

.color-list {
  flex: 1;
  width: 95%;
  flex-direction: column;
  padding-top: 10px;
  padding-bottom: 60px;
}

.color-item {
  width: 100%;
  height: 70px;
  margin-top: 8px;
  border-radius: 20px;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 0 16px;
}

.color-name {
  color: #ffffff;
  font-size: 22px;
  font-weight: 800;
}

.color-tick {
  width: 24px;
  height: 24px;
}

@media (shape: rect) {
  page {
    padding: 18px 0 6px;
  }

  .pill-time {
    display: none;
  }

  .title-round {
    display: none;
  }

  .title-rect {
    display: flex;
    margin-bottom: 8px;
  }

  .color-list {
    padding-top: 0;
    padding-bottom: 30px;
  }

  .color-item {
    height: 80px;
  }

  .color-name {
    font-size: 26px;
  }
}
</style>
