<template>
  <div class="page">
    <text class="pill-time">{{ currentTime }}</text>
    <text class="title title-round">个性化</text>
    <div class="title-row title-rect">
      <div class="title-left" onclick="goBack">
        <div class="title-back-btn">
          <image class="title-back-icon" src="/common/left.png"></image>
        </div>
        <text class="title-text">个性化</text>
      </div>
      <text class="title-text">{{ currentTime }}</text>
    </div>

    <scroll class="settings-list" scroll-y="true" bounces="true">
      <div class="settings-item settings-item-value" onclick="openThemeColor">
        <text class="item-text">主题色</text>
        <text class="item-subtext">{{ themeColorName }}</text>
      </div>
      <div class="settings-item switch-row">
        <text class="switch-label">首页文本居中</text>
        <switch
          class="item-switch"
          checked="{{ centerHomeText }}"
          style="track-color: {{ themeColor }}"
          onchange="toggleCenterHomeText"
        ></switch>
      </div>
      <div class="settings-item switch-row">
        <text class="switch-label">地点前添加@</text>
        <switch
          class="item-switch"
          checked="{{ prefixAtSymbol }}"
          style="track-color: {{ themeColor }}"
          onchange="togglePrefixAtSymbol"
        ></switch>
      </div>
      <div class="settings-item switch-row">
        <text class="switch-label">隐藏授课老师</text>
        <switch
          class="item-switch"
          checked="{{ hideTeacher }}"
          style="track-color: {{ themeColor }}"
          onchange="toggleHideTeacher"
        ></switch>
      </div>
    </scroll>
  </div>
</template>

<script>
import router from "@system.router"
import prompt from "@system.prompt"

const preferences = require("../../common/preferences.js")
const utils = require("../../common/utils.js")

const COLOR_NAMES = {
  "#237bff": "深空蓝",
  "#06b6d4": "冰川青",
  "#8b5cf6": "极光紫",
  "#ec4899": "樱花粉",
  "#15803d": "森林绿",
  "#e0a422": "琥珀黄"
}

export default {
  private: {
    hideTeacher: false,
    themeColor: preferences.getCachedThemeColor(),
    themeColorName: "",
    centerHomeText: false,
    prefixAtSymbol: false,
    currentTime: "",
    timerId: 0
  },

  onInit() {
    utils.startClock(this)
    this.loadPreferences()
  },

  onDestroy() {
    utils.stopClock(this)
  },

  onHide() {
    utils.stopClock(this)
  },

  onShow() {
    utils.startClock(this)
    this.loadPreferences()
  },

  goBack() {
    router.back()
  },

  loadPreferences() {
    preferences.getPreferences((pref) => {
      this.hideTeacher = !!pref.hideTeacher
      this.centerHomeText = !!pref.centerHomeText
      this.prefixAtSymbol = !!pref.prefixAtSymbol
      this.themeColor = pref.themeColor
      this.themeColorName = COLOR_NAMES[pref.themeColor] || COLOR_NAMES[preferences.DEFAULT_COLOR]
    })
  },

  savePreferences(patch) {
    preferences.setPreferences(patch, (ok) => {
      if (!ok) {
        prompt.showToast({
          message: "保存失败",
          duration: 2000
        })
      }
    })
  },

  toggleHideTeacher(event) {
    this.hideTeacher = !!event.checked
    this.savePreferences({hideTeacher: this.hideTeacher})
  },

  toggleCenterHomeText(event) {
    this.centerHomeText = !!event.checked
    this.savePreferences({centerHomeText: this.centerHomeText})
  },

  togglePrefixAtSymbol(event) {
    this.prefixAtSymbol = !!event.checked
    this.savePreferences({prefixAtSymbol: this.prefixAtSymbol})
  },

  openThemeColor() {
    router.push({
      uri: "/pages/theme-color"
    })
  }
}
</script>

<style>
