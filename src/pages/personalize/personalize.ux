  flex-direction: column;
  width: 100%;
  height: 100%;
  padding: 32px 0 6px;
  background-color: #000000;
  align-items: center;
}

.pill-time {
  position: absolute;
  top: 4px;
  font-size: 24px;
  font-weight: bold;
  color: rgba(255, 255, 255, 0.6);
  display: flex;
}

.title {
  color: #ffffff;
  font-size: 26px;
  font-weight: 800;
}

.title-rect {
  display: none;
}

.title-row {
  width: 100%;
  padding: 0 6px;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.title-left {
  flex-direction: row;
  align-items: center;
}

.title-back-btn {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background-color: transparent;
  align-items: center;
  justify-content: center;
  margin-right: 8px;
}

.title-back-icon {
  width: 28px;
  height: 28px;
}

.title-text {
  color: #ffffff;
  font-size: 30px;
  font-weight: 800;
}

.settings-list {
  flex: 1;
  width: 95%;
  flex-direction: column;
  padding-top: 10px;
  padding-bottom: 60px;
}

.settings-item {
  width: 100%;
  height: 101px;
  margin-top: 8px;
  padding: 0 16px;
  border-radius: 20px;
  background-color: rgba(38, 38, 38, 1);
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
}

.switch-row {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.switch-label {
  flex: 1;
  color: #ffffff;
  font-size: 24px;
  font-weight: 800;
}

.item-switch {
  width: 50px;
  height: 25.5px;
  thumb-color: #ffffff;
}

.item-text {
  color: #ffffff;
  font-size: 24px;
  font-weight: 800;
}

.item-subtext {
  margin-top: 4px;
  color: #aaaaaa;
  font-size: 20px;
  font-weight: 700;
}

@media (shape: rect) {
  page {
    padding: 18px 0 6px;
  }

  .pill-time {
    display: none;
  }

  .title-round {
    display: none;
  }

  .title-rect {
    display: flex;
    margin-bottom: 8px;
  }

  .settings-list {
    padding-top: 0;
    padding-bottom: 30px;
  }

  .settings-item {
    height: 80px;
  }

  .settings-item-value {
    height: 115px;
  }

  .switch-label {
    font-size: 26px;
  }

  .item-subtext {
    font-size: 24px;
  }

  .item-switch {
    width: 55px;
    height: 28.5px;
  }
}
</style>
