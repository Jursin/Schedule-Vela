{
  "name": "schedule-vela",
  "version": "1.0.0",
  "private": true,
  "description": "适用于 Vela 设备的课程表快应用",
  "engines": {
    "node": ">=16.0.0"
  },
  "scripts": {
    "start": "aiot start --watch",
    "build": "aiot build",
    "release": "aiot release",
    "lint": "eslint --format codeframe --fix --ext .ux,.js src/",
    "format": "prettier --write \"src/**/*.ux\" \"src/**/*.json\"",
    "check": "prettier --check \"src/**/*.ux\" \"src/**/*.json\"",
    "postinstall": "node scripts/patch-style-config.js"
  },
  "devDependencies": {
    "@aiot-toolkit/jsc": "^1.0.8",
    "aiot-toolkit": "^2.0.5",
    "eslint": "^8.57.1",
    "eslint-formatter-codeframe": "^7.32.2",
    "postcss-less": "^6.0.0",
    "prettier": "^3.9.6",
    "stylelint": "^17.14.1",
    "stylelint-config-recess-order": "^7.7.0",
    "stylelint-config-standard": "^40.0.0",
    "vue-eslint-parser": "^10.4.1"
  }
}
